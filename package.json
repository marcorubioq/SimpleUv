{
  "name": "simple-uv",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone UV layout desktop application for 3D artists.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "generate:test-model": "node scripts/generate-test-model.mjs",
    "native:configure": "cmake -S native -B native/build -G \"Visual Studio 17 2022\" -A x64",
    "native:build": "cmake --build native/build --config Release",
    "native:test": "ctest --test-dir native/build -C Release --output-on-failure",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.1"
  }
}
